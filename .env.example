TINYFISH_API_KEY=
TINYFISH_API_BASE=https://agent.tinyfish.ai/v1
GMAIL_FROM_ADDRESS=
GMAIL_APP_PASSWORD=
APP_BASE_URL=http://localhost:8000
SQLITE_PATH=data/app.db
DEFAULT_COUNTRY_CODE=US
ALLOW_EMAIL_SEND=true
MAX_DISCOVERY_RUNS=2
MAX_ENRICHMENT_RUNS=4
MAX_BRAND_SAFETY_RUNS=1
MAX_CONTACT_RUNS=2
MAX_OUTREACH_RUNS=1
TINYFISH_TIMEOUT_DISCOVERY=300
TINYFISH_TIMEOUT_ENRICHMENT=180
TINYFISH_TIMEOUT_CONTACT=180
TINYFISH_TIMEOUT_OUTREACH=240
BRAND_SAFETY_LLM_API_KEY=
BRAND_SAFETY_LLM_PROVIDER=gemini
BRAND_SAFETY_LLM_MODEL=gemini-2.5-flash
BRAND_SAFETY_SCORE_THRESHOLD=60
